{
  "manifest_version": 3,
  "name": "병무길잡이",
  "version": "0.5.0",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.mma.go.kr/*",
        "https://mwpt.mma.go.kr/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/PretendardGOV-Medium.subset.woff2"
      ],
      "matches": [
        "https://mwpt.mma.go.kr/*"
      ]
    }
  ]
}
